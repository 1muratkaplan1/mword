<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HelpCenter">
    <View
        android:id="@+id/help_center_main_line"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/golden_metalic"
        android:layout_alignParentBottom="true"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/help_center_main_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp"
        android:layout_alignParentTop="true"
        android:text="Help Center"
        android:textAlignment="center"
        android:textColor="@color/golden_metalic"
        android:textSize="35sp"
        android:typeface="monospace"
        app:layout_constraintTop_toBottomOf="@+id/help_center_main_line"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/help_center_underline"
        app:layout_constraintTop_toBottomOf="@+id/help_center_main_text">

    <Button
            android:id="@+id/help_center_about_us"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="ABOUT US"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />

        <Button
            android:id="@+id/help_center_tutoriol"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="TUTORIOL"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />

        <Button
            android:id="@+id/help_center_faqs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="FAQ'S"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />

        <Button
            android:id="@+id/help_center_contact_support"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="CONTACT SUPPORT"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />
        <Button
            android:id="@+id/help_center_termsofservice"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="TERMS OF SERVICE"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />
        <Button
            android:id="@+id/help_center_privacy_policy"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="PRIVACY POLICY"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />
        <Button
            android:id="@+id/help_center_rate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="RATE mWord"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />
        <Button
            android:id="@+id/help_center_getproversion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/main_header_selector"
            android:text="UPDATE PRO VERSION"
            android:textColor="@color/golden_metalic"
            android:textSize="19sp" />
    </LinearLayout>

    
    <View
        android:id="@+id/help_center_underline"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:background="@color/golden_metalic" 
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>